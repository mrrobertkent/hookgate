# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
ARG TARGETOS TARGETARCH VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/hookgate-relay ./cmd/hookgate-relay

# Statically linked: it runs in any image. Extend this one with a static handler, or copy the binary into a
# base that has the libraries your handler needs.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/hookgate-relay /usr/local/bin/hookgate-relay
USER nonroot:nonroot
EXPOSE 9091
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD ["hookgate-relay", "healthcheck"]
ENTRYPOINT ["hookgate-relay"]
CMD ["serve"]
